# Kontorōru — CMS del sitio. Cópialas a un archivo .env.local
# La API Key necesita los permisos: content:read, media:read y forms:write
# (este último para que los formularios escriban en el complemento Contactos).
# Obtenla en: Kontorōru → Ajustes → API Keys
KONTORORU_API_KEY=kntr_live_xxxxxxxxxxxx.yyyyyyyyyyyyyy

# URL de tu instalación, incluyendo /api/v1
KONTORORU_URL=https://tu-instalacion.kontororu.app/api/v1

# Reacciones. Van al navegador (NEXT_PUBLIC_) porque el botón de "me gusta"
# llama al CMS directamente: el endpoint es público y su límite de peticiones
# es por IP, así que pasar por el servidor metería a todos los lectores en el
# mismo cupo. La API Key no interviene.
NEXT_PUBLIC_KONTORORU_URL=https://tu-instalacion.kontororu.app/api/v1
NEXT_PUBLIC_KONTORORU_TENANT=rukma

# Secret del webhook que revalida el caché al publicar.
# Se genera en: Kontorōru → Ajustes → Webhooks
# Endpoint: https://www.rukma.studio/api/revalidate/kontororu
KONTORORU_WEBHOOK_SECRET=tu_webhook_secret
